# ─────────────────────────────────────────────────────────────────────────
#  RivDinde — variables d'environnement du backend
# ─────────────────────────────────────────────────────────────────────────
#
#  Ce fichier est VERSIONNE et ne contient AUCUNE valeur secrete : il liste
#  les variables et explique a quoi chacune sert. Pour travailler :
#
#      copy .env.example .env          (PowerShell)
#
#  puis on remplit .env, qui n'est jamais envoye sur GitHub (.gitignore).
#
#  Regle absolue : une cle ne se colle jamais dans une conversation, dans
#  questions.txt, ni dans un commit. Si ca arrive : on la revoque chez le
#  service et on en genere une nouvelle — la retirer d'un commit ne suffit
#  pas, l'historique reste.
#
#  Rien de ce qui suit n'est obligatoire pour demarrer : sans .env du tout,
#  le projet fonctionne en mode developpement avec la base du docker-compose.


# ── L'essentiel ──────────────────────────────────────────────────────────

# Signe les sessions et les jetons. En developpement, une valeur de repli est
# generee automatiquement. En ligne, elle est OBLIGATOIRE et le serveur refuse
# de demarrer sans elle. Pour en fabriquer une :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# true en developpement, false partout ailleurs. A false, Django cache le
# detail des erreurs — ce qui est exactement ce qu'on veut en ligne, et
# exactement ce qui rend le debogage penible en local.
DEBUG=true

# Les domaines autorises a servir l'API, separes par des virgules.
# En local, la valeur par defaut suffit.
ALLOWED_HOSTS=localhost,127.0.0.1

# Les origines des navigateurs autorises a appeler l'API. Le front Vite
# tourne sur 5173, le front mobile Ionic sur 8100.
CORS_ORIGINS=http://localhost:5173,http://localhost:8100


# ── La base de donnees ───────────────────────────────────────────────────
#
# En local : celle du docker-compose, deja renseignee ci-dessous.
# En ligne  : la chaine fournie par Neon, qui ressemble a
#   postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/rivdinde?sslmode=require
#
# Neon fournit DEUX chaines : la directe et celle "avec pooler". Prendre
# celle avec pooler pour l'application — un hebergeur qui redemarre souvent
# epuise sinon le nombre de connexions autorisees.
# Le port 5433 n'est pas une coquille : le projet banque occupe deja 5432 sur
# cette machine (voir docker-compose.yml). Les deux projets cohabitent.
#
# ATTENTION — NE METS PAS TA CHAINE NEON ICI.
# Ce fichier est celui de ta machine. Si tu y colles l'adresse de Neon, alors
# `demarrer.py` migre la base de PRODUCTION, chaque test la remplit de fausses
# commandes, et un `flush` malheureux l'efface. La chaine Neon se saisit dans
# l'interface de Render au moment du deploiement (tranche 11), nulle part
# ailleurs. En attendant, garde-la dans ton gestionnaire de mots de passe.
DATABASE_URL=postgresql://rivdinde:rivdinde@localhost:5433/rivdinde


# ── Images et fichiers (D-24, contrat-medias.md) ─────────────────────────
#
# LAISSE VIDE, TOUT FONCTIONNE : les images sont ecrites dans backend/media/
# et servies par Django. C'est le principe du simulateur (D-18) — meme
# interface, deux implementations.
#
# En ligne, ces trois valeurs sont OBLIGATOIRES : le disque du conteneur est
# efface a chaque redeploiement, une photo qui y est ecrite disparait.
# Elles se trouvent sur le tableau de bord Cloudinary, section "Product
# Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── Paiement (tranche 5) ─────────────────────────────────────────────────
#
# Cles de MODE TEST uniquement — elles commencent par sk_test_ et pk_test_.
# Une cle de mode test ne peut deplacer aucun argent reel : c'est ce qui
# rend la demonstration possible sans risque.
#
# Laissees vides, le simulateur de paiement prend le relais et le tunnel de
# commande fonctionne de bout en bout hors ligne.
#
# Correspondance avec le tableau de bord Stripe (Developpeurs > Cles d'API) :
#   STRIPE_CLE_SECRETE   = « Secret key »      (sk_test_...)  JAMAIS cote front
#   STRIPE_CLE_PUBLIQUE  = « Publishable key » (pk_test_...)  sans danger cote front
STRIPE_CLE_SECRETE=
STRIPE_CLE_PUBLIQUE=
# Fourni par `stripe listen` en local, ou par le tableau de bord en ligne.
# Sans lui, une confirmation de paiement contrefaite serait acceptee.
STRIPE_WEBHOOK_SECRET=


# ── Courriels (tranche 8) ────────────────────────────────────────────────
#
# En developpement : Mailpit, lance par le docker-compose. C'est un vrai
# serveur SMTP qui accepte tout et ne delivre rien. Boite de reception :
# http://localhost:8026 — on y lit exactement le message qu'aurait recu le
# destinataire, sans qu'aucun courriel ne quitte la machine.
#
# 1026 et non 1025, pour la meme raison que le port de la base : le Mailpit
# du projet banque occupe deja 1025 et 8025.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_EXPEDITEUR=RivDinde <ne-pas-repondre@rivdinde.local>

# Beaucoup d'hebergeurs — Render sur son offre gratuite en particulier —
# BLOQUENT les ports SMTP sortants (25, 465, 587), parce que c'est par la
# que partent les campagnes de pourriel. La connexion expire sans message
# clair. Renseignee, cette cle fait passer les courriels par l'API HTTP du
# fournisseur, sur le port 443, et SMTP_HOST est alors ignore.
EMAIL_API_KEY=


# ── Geocodage (D-25) ─────────────────────────────────────────────────────
#
# Nominatim (OpenStreetMap) : gratuit, sans compte, sans carte bancaire.
# Sa politique d'usage demande une adresse de contact identifiable et
# plafonne a une requete par seconde — largement au-dessus de nos besoins,
# puisqu'on ne geocode qu'a l'enregistrement d'une adresse, jamais a
# l'affichage. Les distances sont calculees en local (haversine).
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_CONTACT=rivdinde-projet-etudiant@exemple.fr


# ── Compte administrateur fondateur (D-01) ───────────────────────────────
#
# Utilises par `python manage.py seed_admin`, qui cree le tout premier
# compte admin directement en base. Il n'existe aucun formulaire public
# "devenir admin" — ce serait une faille evidente.
ADMIN_EMAIL=admin@rivdinde.local
ADMIN_MOT_DE_PASSE=

# --- Agent IA---
AI_API_KEY=
